---
import LegalPage from '../components/LegalPage.astro';

const title = 'Pengaturan Cookie';
const description = 'Kelola preferensi cookie Panduan Benteng Rotterdam: penyimpanan esensial, analitik, dan preferensi. Pilihan disimpan di peramban Anda.';
---
<LegalPage {title} {description} eyebrow="Kontrol privasi" updated="Agustus 2026" showBanner={false}>
  <p class="font-semibold text-[#173b3f]/82">Anda dapat mengubah pilihan kapan saja. Menonaktifkan kategori opsional tidak menghalangi akses ke informasi utama situs.</p>

  <form id="cookie-form" class="space-y-4">
    <label class="flex gap-4 rounded-2xl border border-[#173b3f]/12 p-4">
      <input type="checkbox" checked disabled class="mt-1 size-5 accent-[#8a3428]" />
      <span><strong class="block">Penyimpanan esensial — selalu aktif</strong><span class="mt-1 block text-sm leading-6 text-[#173b3f]/70">Diperlukan untuk mengingat pilihan persetujuan dan fungsi dasar keamanan. Tidak digunakan untuk iklan.</span></span>
    </label>

    <label class="flex gap-4 rounded-2xl border border-[#173b3f]/12 p-4">
      <input id="consent-analytics" type="checkbox" class="mt-1 size-5 accent-[#8a3428]" />
      <span><strong class="block">Analitik — Google Analytics 4</strong><span class="mt-1 block text-sm leading-6 text-[#173b3f]/70">Membantu memahami penggunaan halaman secara agregat. Skrip analitik tidak dimuat sebelum Anda menyetujui kategori ini.</span></span>
    </label>

    <label class="flex gap-4 rounded-2xl border border-[#173b3f]/12 p-4">
      <input id="consent-preferences" type="checkbox" class="mt-1 size-5 accent-[#8a3428]" />
      <span><strong class="block">Preferensi</strong><span class="mt-1 block text-sm leading-6 text-[#173b3f]/70">Mengizinkan situs mengingat pengaturan antarmuka yang Anda pilih bila fitur preferensi digunakan.</span></span>
    </label>

    <label class="flex gap-4 rounded-2xl border border-[#173b3f]/12 bg-[#173b3f]/5 p-4 opacity-75">
      <input type="checkbox" disabled class="mt-1 size-5" />
      <span><strong class="block">Pemasaran — tidak digunakan</strong><span class="mt-1 block text-sm leading-6 text-[#173b3f]/70">Situs ini tidak menayangkan iklan yang dipersonalisasi dan tidak mengaktifkan Cookie pemasaran.</span></span>
    </label>

    <div class="flex flex-wrap items-center gap-2 border-t border-[#173b3f]/10 pt-5">
      <p id="cookie-saved" class="mr-auto rounded-full bg-[#173b3f]/7 px-4 py-2 text-sm font-bold text-[#173b3f]" hidden>Preferensi Anda telah disimpan.</p>
      <button id="cookie-reject" type="button" class="rounded-full border border-[#173b3f]/25 px-5 py-2.5 text-sm font-bold hover:bg-[#173b3f]/5">Tolak semua yang opsional</button>
      <button type="submit" class="rounded-full bg-[#173b3f] px-5 py-2.5 text-sm font-black text-white hover:bg-[#8a3428]">Simpan preferensi</button>
    </div>
  </form>
</LegalPage>

<script>
  const CONSENT_KEY = 'benteng-rotterdam-consent-v1';
  const GA_ID = 'G-HXM22WWPKP';
  const form = document.querySelector<HTMLFormElement>('#cookie-form');
  const analytics = document.querySelector<HTMLInputElement>('#consent-analytics');
  const preferences = document.querySelector<HTMLInputElement>('#consent-preferences');
  const savedMessage = document.querySelector<HTMLElement>('#cookie-saved');
  let gaLoaded = false;

  type ConsentValue = { analytics: boolean; preferences: boolean };

  const readConsent = (): ConsentValue | null => {
    try {
      const raw = localStorage.getItem(CONSENT_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw) as Partial<ConsentValue>;
      return { analytics: parsed.analytics === true, preferences: parsed.preferences === true };
    } catch {
      return null;
    }
  };

  const loadAnalytics = () => {
    if (gaLoaded) return;
    gaLoaded = true;
    const dataLayer: unknown[][] = [];
    Reflect.set(window, 'dataLayer', dataLayer);
    const gtag = (...args: unknown[]) => dataLayer.push(args);
    Reflect.set(window, 'gtag', gtag);
    gtag('js', new Date());
    gtag('config', GA_ID, { anonymize_ip: true });

    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(GA_ID)}`;
    document.head.appendChild(script);
  };

  const applyConsent = (value: ConsentValue) => {
    if (analytics) analytics.checked = value.analytics;
    if (preferences) preferences.checked = value.preferences;
    Reflect.set(window, `ga-disable-${GA_ID}`, !value.analytics);
    if (value.analytics) loadAnalytics();
  };

  const saveConsent = (value: ConsentValue) => {
    localStorage.setItem(CONSENT_KEY, JSON.stringify({ ...value, savedAt: new Date().toISOString() }));
    applyConsent(value);
    if (savedMessage) savedMessage.hidden = false;
  };

  const current = readConsent();
  if (current) applyConsent(current);

  document.getElementById('cookie-reject')?.addEventListener('click', () => saveConsent({ analytics: false, preferences: false }));

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    saveConsent({ analytics: analytics?.checked === true, preferences: preferences?.checked === true });
  });
</script>
