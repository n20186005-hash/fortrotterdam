---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Halaman tidak ditemukan — Panduan Benteng Rotterdam" description="Halaman yang Anda cari tidak tersedia.">
  <main class="grid min-h-screen place-items-center px-6 py-20 text-center">
    <div class="max-w-xl">
      <img src="/favicon.svg" alt="" class="mx-auto size-20" />
      <p class="eyebrow mt-8">404</p>
      <h1 class="mt-3 text-5xl font-bold">Halaman tidak ditemukan.</h1>
      <p class="mt-5 leading-7 text-[#173b3f]/65">Tautan mungkin sudah berubah atau alamat yang dimasukkan tidak tepat.</p>
      <a href="/" class="mt-8 inline-flex rounded-full bg-[#173b3f] px-6 py-3 text-sm font-black text-white">Kembali ke panduan</a>
    </div>
  </main>
</BaseLayout>
