<div id="cookie-banner" class="cookie-banner rounded-2xl border border-white/20 bg-[#173b3f] p-5 text-[#fffaf0] md:p-6" hidden>
  <div class="grid gap-5 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="text-sm font-black uppercase tracking-[.16em] text-[#e3ba76]">Privasi & Cookie</p>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-white/85">Kami menggunakan penyimpanan yang diperlukan untuk mengingat pilihan Anda. Google Analytics hanya dimuat bila Anda menyetujuinya. Anda dapat menolak semua kategori opsional.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <button id="cookie-essential" type="button" class="rounded-full border border-white/25 px-4 py-2 text-sm font-bold hover:bg-white/10">Hanya esensial</button>
      <button id="cookie-accept" type="button" class="rounded-full bg-[#e3ba76] px-4 py-2 text-sm font-black text-[#173b3f] hover:bg-white">Izinkan analitik</button>
      <button type="button" data-dialog="cookie-dialog" class="rounded-full border border-white/25 px-4 py-2 text-sm font-bold hover:bg-white/10">Atur</button>
    </div>
  </div>
</div>

<dialog id="cookie-dialog" class="dialog-panel">
  <div class="sticky top-0 z-10 flex items-center justify-between border-b border-[#173b3f]/10 bg-[#fffaf0]/95 px-6 py-4 backdrop-blur">
    <div>
      <p class="eyebrow">Kontrol privasi</p>
      <h2 class="mt-1 text-2xl">Pengaturan Cookie</h2>
    </div>
    <button type="button" data-close-dialog class="rounded-full border border-[#173b3f]/20 px-4 py-2 text-sm font-bold hover:bg-[#173b3f] hover:text-white">Tutup</button>
  </div>
  <form id="cookie-form" class="space-y-6 px-6 py-7 md:px-9">
    <p class="font-semibold">Terakhir diperbarui: Agustus 2026</p>
    <p class="text-sm leading-6">Anda dapat mengubah pilihan kapan saja. Menonaktifkan kategori opsional tidak menghalangi akses ke informasi utama situs.</p>

    <label class="flex gap-4 rounded-2xl border border-[#173b3f]/12 p-4">
      <input type="checkbox" checked disabled class="mt-1 size-5 accent-[#8a3428]" />
      <span><strong class="block">Penyimpanan esensial — selalu aktif</strong><span class="mt-1 block text-sm leading-6 text-[#173b3f]/70">Diperlukan untuk mengingat pilihan persetujuan dan fungsi dasar keamanan. Tidak digunakan untuk iklan.</span></span>
    </label>

    <label class="flex gap-4 rounded-2xl border border-[#173b3f]/12 p-4">
      <input id="consent-analytics" type="checkbox" class="mt-1 size-5 accent-[#8a3428]" />
      <span><strong class="block">Analitik — Google Analytics 4</strong><span class="mt-1 block text-sm leading-6 text-[#173b3f]/70">Membantu memahami penggunaan halaman secara agregat. Skrip analitik tidak dimuat sebelum Anda menyetujui kategori ini.</span></span>
    </label>

    <label class="flex gap-4 rounded-2xl border border-[#173b3f]/12 p-4">
      <input id="consent-preferences" type="checkbox" class="mt-1 size-5 accent-[#8a3428]" />
      <span><strong class="block">Preferensi</strong><span class="mt-1 block text-sm leading-6 text-[#173b3f]/70">Mengizinkan situs mengingat pengaturan antarmuka yang Anda pilih bila fitur preferensi digunakan.</span></span>
    </label>

    <label class="flex gap-4 rounded-2xl border border-[#173b3f]/12 bg-[#173b3f]/5 p-4 opacity-75">
      <input type="checkbox" disabled class="mt-1 size-5" />
      <span><strong class="block">Pemasaran — tidak digunakan</strong><span class="mt-1 block text-sm leading-6 text-[#173b3f]/70">Situs ini tidak menayangkan iklan yang dipersonalisasi dan tidak mengaktifkan Cookie pemasaran.</span></span>
    </label>

    <div class="flex flex-wrap justify-end gap-2 border-t border-[#173b3f]/10 pt-5">
      <button id="cookie-reject" type="button" class="rounded-full border border-[#173b3f]/25 px-5 py-2.5 text-sm font-bold">Tolak semua yang opsional</button>
      <button type="submit" class="rounded-full bg-[#173b3f] px-5 py-2.5 text-sm font-black text-white">Simpan preferensi</button>
    </div>
  </form>
</dialog>

<script>
  const CONSENT_KEY = 'benteng-rotterdam-consent-v1';
  const GA_ID = 'G-HXM22WWPKP';
  const banner = document.querySelector<HTMLElement>('#cookie-banner');
  const form = document.querySelector<HTMLFormElement>('#cookie-form');
  const analytics = document.querySelector<HTMLInputElement>('#consent-analytics');
  const preferences = document.querySelector<HTMLInputElement>('#consent-preferences');
  let gaLoaded = false;

  type ConsentValue = { analytics: boolean; preferences: boolean };

  const readConsent = (): ConsentValue | null => {
    try {
      const raw = localStorage.getItem(CONSENT_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw) as Partial<ConsentValue>;
      return { analytics: parsed.analytics === true, preferences: parsed.preferences === true };
    } catch {
      return null;
    }
  };

  const closeDialog = (id: string) => {
    const dialog = document.getElementById(id);
    if (dialog instanceof HTMLDialogElement) dialog.close();
  };

  const loadAnalytics = () => {
    if (gaLoaded) return;
    gaLoaded = true;
    const dataLayer: unknown[][] = [];
    Reflect.set(window, 'dataLayer', dataLayer);
    const gtag = (...args: unknown[]) => dataLayer.push(args);
    Reflect.set(window, 'gtag', gtag);
    gtag('js', new Date());
    gtag('config', GA_ID, { anonymize_ip: true });

    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(GA_ID)}`;
    document.head.appendChild(script);
  };

  const applyConsent = (value: ConsentValue) => {
    if (analytics) analytics.checked = value.analytics;
    if (preferences) preferences.checked = value.preferences;
    Reflect.set(window, `ga-disable-${GA_ID}`, !value.analytics);
    if (value.analytics) loadAnalytics();
  };

  const saveConsent = (value: ConsentValue) => {
    localStorage.setItem(CONSENT_KEY, JSON.stringify({ ...value, savedAt: new Date().toISOString() }));
    applyConsent(value);
    if (banner) banner.hidden = true;
  };

  const current = readConsent();
  if (current) applyConsent(current);
  else if (banner) banner.hidden = false;

  document.getElementById('cookie-essential')?.addEventListener('click', () => saveConsent({ analytics: false, preferences: false }));
  document.getElementById('cookie-accept')?.addEventListener('click', () => saveConsent({ analytics: true, preferences: false }));
  document.getElementById('cookie-reject')?.addEventListener('click', () => {
    saveConsent({ analytics: false, preferences: false });
    closeDialog('cookie-dialog');
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    saveConsent({ analytics: analytics?.checked === true, preferences: preferences?.checked === true });
    closeDialog('cookie-dialog');
  });

  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (target?.closest('[data-dialog="cookie-dialog"]')) {
      applyConsent(readConsent() ?? { analytics: false, preferences: false });
    }
  });
</script>
