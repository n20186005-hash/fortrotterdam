<div id="cookie-banner" class="cookie-banner rounded-2xl border border-white/20 bg-[#173b3f] p-5 text-[#fffaf0] md:p-6" hidden>
  <div class="grid gap-5 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="text-sm font-black uppercase tracking-[.16em] text-[#e3ba76]">Privasi & Cookie</p>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-white/85">Kami menggunakan penyimpanan yang diperlukan untuk mengingat pilihan Anda. Google Analytics hanya dimuat bila Anda menyetujuinya. Anda dapat menolak semua kategori opsional.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <button id="cookie-essential" type="button" class="rounded-full border border-white/25 px-4 py-2 text-sm font-bold hover:bg-white/10">Hanya esensial</button>
      <button id="cookie-accept" type="button" class="rounded-full bg-[#e3ba76] px-4 py-2 text-sm font-black text-[#173b3f] hover:bg-white">Izinkan analitik</button>
      <a href="/pengaturan-cookie/" class="rounded-full border border-white/25 px-4 py-2 text-sm font-bold hover:bg-white/10">Atur</a>
    </div>
  </div>
</div>

<script>
  const CONSENT_KEY = 'benteng-rotterdam-consent-v1';
  const GA_ID = 'G-HXM22WWPKP';
  const banner = document.querySelector<HTMLElement>('#cookie-banner');
  let gaLoaded = false;

  type ConsentValue = { analytics: boolean; preferences: boolean };

  const readConsent = (): ConsentValue | null => {
    try {
      const raw = localStorage.getItem(CONSENT_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw) as Partial<ConsentValue>;
      return { analytics: parsed.analytics === true, preferences: parsed.preferences === true };
    } catch {
      return null;
    }
  };

  const loadAnalytics = () => {
    if (gaLoaded) return;
    gaLoaded = true;
    const dataLayer: unknown[][] = [];
    Reflect.set(window, 'dataLayer', dataLayer);
    const gtag = (...args: unknown[]) => dataLayer.push(args);
    Reflect.set(window, 'gtag', gtag);
    gtag('js', new Date());
    gtag('config', GA_ID, { anonymize_ip: true });

    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(GA_ID)}`;
    document.head.appendChild(script);
  };

  const applyConsent = (value: ConsentValue) => {
    Reflect.set(window, `ga-disable-${GA_ID}`, !value.analytics);
    if (value.analytics) loadAnalytics();
  };

  const saveConsent = (value: ConsentValue) => {
    localStorage.setItem(CONSENT_KEY, JSON.stringify({ ...value, savedAt: new Date().toISOString() }));
    applyConsent(value);
    if (banner) banner.hidden = true;
  };

  const current = readConsent();
  if (current) applyConsent(current);
  else if (banner) banner.hidden = false;

  document.getElementById('cookie-essential')?.addEventListener('click', () => saveConsent({ analytics: false, preferences: false }));
  document.getElementById('cookie-accept')?.addEventListener('click', () => saveConsent({ analytics: true, preferences: false }));
</script>
